# Interactive build job: condor_submit -i experiments/coap-revision/chtc/build.sub
# (submit from experiments/coap-revision after running chtc/make_tarballs.sh)
universe = vanilla
log = chtc/logs/build.log
executable = /usr/bin/hostname
transfer_input_files = chtc/julia-1.13.3-linux-x86_64.tar.gz, chtc/code.tar.gz, chtc/build_env.sh
+IsBuildJob = true
request_cpus = 1
request_memory = 8GB
request_disk = 8GB
transfer_output_files = depot.tar.gz
queue
